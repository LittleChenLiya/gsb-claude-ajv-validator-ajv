{
  "$id": "order.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Order entry: references the shared defs and the user schema",
  "type": "object",
  "properties": {
    "id": {"$ref": "defs.schema.json#/$defs/id"},
    "customer": {"$ref": "user.schema.json"},
    "total": {"type": "number", "minimum": 0}
  },
  "required": ["id", "customer", "total"],
  "additionalProperties": false
}
